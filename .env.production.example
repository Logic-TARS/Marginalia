# Copy to .env.production. Never commit the populated file.

CORS_ORIGINS=https://read.zengziyang.com
ALLOWED_HOSTS=read.zengziyang.com,localhost,127.0.0.1
MAX_EPUB_UPLOAD_MB=90

# Create a remotely managed Cloudflare Tunnel and paste its token here.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# The production Compose file overrides this URL so the container reaches
# Windows-native Ollama through host.docker.internal.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional OpenAI-compatible chat endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional; a Windows host path is not automatically visible in the container.
OBSIDIAN_VAULT_PATH=
