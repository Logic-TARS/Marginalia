# Marginalia Configuration
# Copy this file to .env and fill in your values

# Browser origins and HTTP Host values (comma-separated).
# Production values are documented in .env.production.example.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI-compatible chat endpoint (optional)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-v4-pro

# Local OpenAI-compatible embedding endpoint
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Legacy fallback, used only when EMBEDDING_MODEL is absent:
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Maximum EPUB size accepted for server storage and AI indexing (MB)
# MAX_EPUB_UPLOAD_MB=90

# Free on-demand chapter narration (edge-tts; no API key)
TTS_ENABLED=true
TTS_PROVIDER=edge-tts
# TTS_STORAGE_PATH=backend/data/tts
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_MAX_CONCURRENCY=3
TTS_MAX_RETRIES=3
TTS_SEGMENT_MAX_CHARS=1000
TTS_REQUEST_TIMEOUT=120
TTS_CACHE_RETENTION_DAYS=30
TTS_MAX_TASKS_PER_CLIENT=2
TTS_CREATE_RATE_LIMIT_PER_MINUTE=10
TTS_MIN_AUDIO_BYTES=128

# Obsidian export vault path (optional)
# OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
